# ===========================
# Root-level .gitignore
# Catches anything missed by nested .gitignores
# ===========================

# Environment & Secrets (root-level safeguard)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
*.keystore
*.secret
secrets/
credentials/
serviceAccountKey.json
*service_account*.json
google-credentials.json
firebase-adminsdk*.json
gcp-credentials.json
.aws/

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*.swp
